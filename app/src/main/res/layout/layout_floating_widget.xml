<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 全屏锁屏界面 -->
    <LinearLayout
        android:id="@+id/lock_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_lock_screen"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="visible">

        <!-- 长题目（如古诗教学卡）超出屏幕时整卡可滚动 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_quiz_card"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 第 1/20 题"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/quiz_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:progressDrawable="@drawable/progress_quiz"
                android:progress="0" />

            <!-- 家长消息横幅（飞书远程发来，默认隐藏）-->
            <TextView
                android:id="@+id/tv_parent_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_parent_msg"
                android:padding="12dp"
                android:gravity="center"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 孩子快捷回复（有家长消息时显示）-->
            <LinearLayout
                android:id="@+id/quick_reply_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <Button android:id="@+id/btn_qr_1" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="好的👌" android:textColor="#333333" android:textSize="15sp" android:textAllCaps="false" />
                <Button android:id="@+id/btn_qr_2" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="知道啦" android:textColor="#333333" android:textSize="15sp" android:textAllCaps="false" />
                <Button android:id="@+id/btn_qr_3" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="想你了❤️" android:textColor="#333333" android:textSize="15sp" android:textAllCaps="false" />
                <Button android:id="@+id/btn_qr_4" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="等下就好" android:textColor="#333333" android:textSize="15sp" android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="题目加载中..."
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_replay_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/btn_ghost_pill"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:text="🔊 再听一次"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/btn_ghost_pill"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:text="💡 想一想"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_ans_1"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/btn_option_style"
                    android:textAllCaps="false"
                    android:textColor="#333333"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_ans_2"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/btn_option_style"
                    android:textAllCaps="false"
                    android:textColor="#333333"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_ans_3"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/btn_option_style"
                    android:textAllCaps="false"
                    android:textColor="#333333"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btn_ans_4"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/btn_option_style"
                    android:textAllCaps="false"
                    android:textColor="#333333"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- 手输得数题：数字键盘 (③) -->
            <LinearLayout
                android:id="@+id/input_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_input_display"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/btn_option_style"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#333333"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_k1" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="1" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                    <Button android:id="@+id/btn_k2" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="2" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                    <Button android:id="@+id/btn_k3" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="3" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_k4" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="4" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                    <Button android:id="@+id/btn_k5" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="5" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                    <Button android:id="@+id/btn_k6" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="6" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_k7" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="7" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                    <Button android:id="@+id/btn_k8" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="8" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                    <Button android:id="@+id/btn_k9" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="9" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_kdel" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="⌫" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                    <Button android:id="@+id/btn_k0" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="0" android:textColor="#333333" android:textSize="22sp" android:textAllCaps="false" />
                    <Button android:id="@+id/btn_kok" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/btn_option_style" android:text="✓ 确定" android:textColor="#333333" android:textSize="20sp" android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFEB3B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="invisible" />
        </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 结果界面 (复用美化风格) -->
    <LinearLayout
        android:id="@+id/result_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_lock_screen"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_quiz_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/tv_result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="挑战结束"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_result_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="..."
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:background="@drawable/btn_option_style"
                android:text="重新挑战"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 悬浮窗倒计时界面 -->
    <LinearLayout
        android:id="@+id/timer_container"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_timer_widget"
        android:gravity="center"
        android:elevation="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>